<Window x:Class="SonoIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SonoIsland.Controls"
        xmlns:local="clr-namespace:SonoIsland"
        Title="Sono Island"
        Width="520" Height="84"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Jakarta}"
        Cursor="Arrow">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F2080A0E"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9C9CA4"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF6A6A72"/>
        <SolidColorBrush x:Key="EdgeBrush" Color="#1AFFFFFF"/>

        <Geometry x:Key="PlayGeo">M8 5v14l11-7z</Geometry>
        <Geometry x:Key="PauseGeo">M6 19h4V5H6v14zm8-14v14h4V5h-4z</Geometry>
        <Geometry x:Key="PrevGeo">M6 6h2v12H6zm3.5 6l8.5 6V6z</Geometry>
        <Geometry x:Key="NextGeo">M6 18l8.5-6L6 6v12zm10-12h2v12h-2z</Geometry>
        <Geometry x:Key="NoteGeo">M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z</Geometry>
        <Geometry x:Key="LyricGeo">M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zM4 12h4v2H4v-2zm10 6H4v-2h10v2zm6 0h-4v-2h4v2zm0-4H10v-2h10v2z</Geometry>

        <!-- Invisible full-panel click target -->
        <Style x:Key="HitArea" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#26FFFFFF" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#4AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgressSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="14">
                            <Border x:Name="TrackBg" Height="3" CornerRadius="1.5"
                                    Background="#33FFFFFF" VerticalAlignment="Center"/>
                            <Border x:Name="TrackFill" Height="3" CornerRadius="1.5"
                                    Background="{StaticResource TextPrimaryBrush}"
                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{x:Static local:MainWindow.ProgressFillInstance}">
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ActualWidth" ElementName="TrackBg"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="10" Height="10" Fill="{StaticResource TextPrimaryBrush}"
                                                         Opacity="0.9" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cinematic fade at the top/bottom of the lyrics viewport -->
        <LinearGradientBrush x:Key="LyricFade" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00FFFFFF" Offset="0"/>
            <GradientStop Color="#FFFFFFFF" Offset="0.30"/>
            <GradientStop Color="#FFFFFFFF" Offset="0.70"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <!-- Soft shadow: concentric strokes instead of a blur, because a blur is
             re-rasterised every frame on a software-composited layered window. -->
        <ctl:IslandShape x:Name="NotchShadow"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                BottomRadius="{Binding (ctl:CornerHelper.BottomRadius), ElementName=Notch}"
                FlareRadius="{Binding (ctl:CornerHelper.Flare), ElementName=Notch}"
                ShadowLayers="1" IsHitTestVisible="False"/>

        <!-- The island body: vertical gradient (#0F1013 -> #040405) with a
             bottom inner-edge glow (white 10% fading in from the lower half). The
             Border above supplies content + hit-testing and is fully transparent. -->
        <ctl:IslandShape x:Name="NotchShape"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                BottomRadius="{Binding (ctl:CornerHelper.BottomRadius), ElementName=Notch}"
                FlareRadius="{Binding (ctl:CornerHelper.Flare), ElementName=Notch}"
                StrokeThickness="2" IsHitTestVisible="False">
            <ctl:IslandShape.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF0F1013" Offset="0"/>
                    <GradientStop Color="#FF040405" Offset="1"/>
                </LinearGradientBrush>
            </ctl:IslandShape.Fill>
            <ctl:IslandShape.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#1AFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </ctl:IslandShape.Stroke>
        </ctl:IslandShape>

        <!-- Album-tint wash (LYRICS surface only): a horizontal
             gradient built from the cover's tint. Fill + opacity are set from code. -->
        <ctl:IslandShape x:Name="WashShape"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                BottomRadius="{Binding (ctl:CornerHelper.BottomRadius), ElementName=Notch}"
                FlareRadius="{Binding (ctl:CornerHelper.Flare), ElementName=Notch}"
                Opacity="0" IsHitTestVisible="False"/>

        <!-- The island capsule: attached flush to the top edge, bottom corners rounded.
             Layered gradients (body + edge light + specular arc) stand in for real
             backdrop blur, which WPF cannot do on a per-pixel-shaped layered window. -->
        <Border x:Name="Notch"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Width="62" Height="42"
                Background="Transparent"
                BorderThickness="0"
                ctl:CornerHelper.BottomRadius="21"
                ctl:CornerHelper.Flare="16"
                MouseLeave="Notch_MouseLeave"
                MouseMove="Notch_MouseMove">

            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Settings..." Click="OpenSettings_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="CloseApp_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <Grid x:Name="Panels">

                <!-- COLLAPSED - LINE surface (width 124-440 x 36) -->
                <!-- Cover 24 (radius 12) + 10 gap + one sweeping lyric line; padding 6/18. -->
                <Grid x:Name="IdlePanel" Visibility="Collapsed">
                    <Button x:Name="IdleHit" Style="{StaticResource HitArea}" Click="Idle_Click"/>

                    <Grid Margin="6,0,18,0" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center">
                            <Ellipse Fill="#12FFFFFF"/>
                            <Image x:Name="IdleArt" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip>
                                    <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12"/>
                                </Image.Clip>
                            </Image>
                            <Ellipse x:Name="IdlePlaceholder" Fill="#12FFFFFF" Visibility="Collapsed"/>
                            <Path x:Name="IdleNote" Data="{StaticResource NoteGeo}" Fill="#66FFFFFF"
                                  Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                            <Ellipse Stroke="#26FFFFFF" StrokeThickness="1"/>
                        </Grid>

                        <!-- current lyric line (dim base + bright clipped copy, karaoke sweep) -->
                        <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                              ClipToBounds="True">
                            <TextBlock x:Name="CapsuleLyricBase" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="CapsuleLyricTop" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Clip>
                                    <RectangleGeometry x:Name="CapsuleSweep" Rect="0,0,0,24"/>
                                </TextBlock.Clip>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Collapsed = the LINE pill (see IdlePanel above). The multi-line
                     lyric viewport now lives on the expanded LYRICS page. -->

                <!-- EXPANDED - MUSIC (432x176) / LYRICS (576x176) -->
                <Grid x:Name="ExpandedPanel" Visibility="Collapsed">
                    <Button x:Name="ExpandedHit" Style="{StaticResource HitArea}" Click="Expanded_Click"/>

                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- MUSIC = one column (this one). LYRICS = left column + 1px divider +
                             scrolling lyric column (two-column layout). -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LeftCol" Width="*"/>
                            <ColumnDefinition x:Name="DividerCol" Width="0"/>
                            <ColumnDefinition x:Name="LyricsCol" Width="0"/>
                        </Grid.ColumnDefinitions>

                        <!-- header: cover 64 (radius 14) + title/artist; bars pinned top-right -->
                        <Grid Grid.Row="0" Grid.Column="0" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="64" Height="64">
                                <Ellipse Fill="#12FFFFFF"/>
                                <Image x:Name="ArtC" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14"/>
                                    </Image.Clip>
                                </Image>
                                <Rectangle RadiusX="14" RadiusY="14" Stroke="#22FFFFFF" StrokeThickness="1"
                                           Fill="Transparent"/>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="14,0,28,0" VerticalAlignment="Center">
                                <Grid x:Name="TitleClip" ClipToBounds="True" HorizontalAlignment="Left">
                                    <TextBlock x:Name="TitleC" FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Left"
                                               Foreground="{StaticResource TextPrimaryBrush}">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="TitleShift"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                                <TextBlock x:Name="ArtistC" FontSize="12.5" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <Grid x:Name="MusicLyricLine" Margin="0,3,0,0" ClipToBounds="True">
                                    <TextBlock x:Name="ExpLyricCurrent" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#80FFFFFF"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ExpLyricTop" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Clip>
                                            <RectangleGeometry x:Name="ExpLyricSweep" Rect="0,0,0,24"/>
                                        </TextBlock.Clip>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <ctl:Visualizer x:Name="VizC" Grid.Column="1" Width="16" Height="12"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,19,20,0"/>
                        </Grid>

                        <!-- progress: elapsed 38 | track (3px) | duration 38 -->
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurrentTime" Grid.Column="0" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Slider x:Name="ProgressSlider" Grid.Column="1"
                                    Minimum="0" Maximum="1" Value="0" IsMoveToPointEnabled="True"
                                    Style="{StaticResource ProgressSlider}"/>
                            <TextBlock x:Name="Duration" Grid.Column="2" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- transport: [*] prev 4 play 4 next [*] lyrics-toggle -->
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="1" Style="{StaticResource IconBtn}" Width="28" Height="28"
                                    Click="Prev_Click" ToolTip="Previous">
                                <Path Data="{StaticResource PrevGeo}" Fill="{StaticResource TextPrimaryBrush}"
                                      Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource PlayBtn}" Width="40" Height="40"
                                    Margin="4,0,4,0" Click="PlayPause_Click" ToolTip="Play/Pause">
                                <Path x:Name="PlayIcon" Data="{StaticResource PlayGeo}"
                                      Fill="{StaticResource TextPrimaryBrush}"
                                      Width="15" Height="15" Stretch="Uniform"/>
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource IconBtn}" Width="28" Height="28"
                                    Click="Next_Click" ToolTip="Next">
                                <Path Data="{StaticResource NextGeo}" Fill="{StaticResource TextPrimaryBrush}"
                                      Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                            <Button Grid.Column="7" Style="{StaticResource IconBtn}" Width="28" Height="28"
                                    Click="LyricsPage_Click" ToolTip="Lyrics">
                                <Path Data="{StaticResource LyricGeo}" Fill="{StaticResource TextSecondaryBrush}"
                                      Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <!-- page dots: active = 14x4 pill, inactive = 4x4 circle -->
                        <StackPanel x:Name="PageDots" Grid.Row="3" Grid.Column="0"
                                    Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Top" Margin="0,7,0,0">
                            <Border x:Name="Dot0" Width="14" Height="4" CornerRadius="2"
                                    Background="#E6FFFFFF" Margin="0,0,4,0"/>
                            <Border x:Name="Dot1" Width="4" Height="4" CornerRadius="2"
                                    Background="#4DFFFFFF"/>
                        </StackPanel>

                        <!-- LYRICS column: 1px divider (white 9%, inset 30 from top) + the
                             scrolling lyric stack, padded 22/18. -->
                        <Border x:Name="PageDivider" Grid.Column="1" Grid.RowSpan="4"
                                Width="1" Margin="0,30,0,0" Background="#17FFFFFF"
                                Visibility="Collapsed"/>

                        <Grid x:Name="LyricsViewport" Grid.Column="2" Grid.RowSpan="4"
                              Margin="22,0,18,0" ClipToBounds="True" Visibility="Collapsed"
                              IsHitTestVisible="False"
                              OpacityMask="{StaticResource LyricFade}">
                            <StackPanel x:Name="LyricsLines">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="LyricsTranslate"/>
                                </StackPanel.RenderTransform>
                            </StackPanel>
                            <TextBlock x:Name="LyricsFallback" FontSize="12.5" TextWrapping="Wrap"
                                       TextAlignment="Left" HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- specular arc: the "light catching the edge" highlight -->
            <Border x:Name="Specular" VerticalAlignment="Top" Height="1.5"
                    Margin="16,0,16,0" CornerRadius="1" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#3EFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
