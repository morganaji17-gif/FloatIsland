<Window x:Class="SonoIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SonoIsland.Models"
        Title="Sono Island — Settings"
        Width="440" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="#FF14141A"
        FontFamily="Segoe UI, Arial"
        Foreground="#FFEFEFF5">
    <Window.Resources>
        <SolidColorBrush x:Key="LabelBrush" Color="#FFEFEFF5"/>
        <SolidColorBrush x:Key="SubBrush" Color="#FF9A9AA5"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FF1E1E26"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FF2E2E3A"/>

        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style x:Key="FieldDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Sono Island Settings"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource LabelBrush}" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Text="Notch overlay, synced lyrics and Spotify audio visualization"
                   FontSize="11.5" Foreground="{StaticResource SubBrush}" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Height="32" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="80" Height="32" Click="Save_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Startup" Style="{StaticResource FieldHeader}"/>
            <CheckBox Style="{StaticResource Toggle}" x:Name="LaunchBox"
                      Content="Launch on Windows startup"/>
            <CheckBox Style="{StaticResource Toggle}" x:Name="StartMinBox"
                      Content="Start minimized (hidden until music begins)"/>

            <TextBlock Text="Music behaviour" Style="{StaticResource FieldHeader}"/>
            <CheckBox Style="{StaticResource Toggle}" x:Name="ShowOnPlayBox" Content="Show when music starts"/>
            <CheckBox Style="{StaticResource Toggle}" x:Name="HideOnStopBox" Content="Hide when music stops"/>
            <CheckBox Style="{StaticResource Toggle}" x:Name="CollapseIdleBox" Content="Collapse to notch when idle"/>
            <CheckBox Style="{StaticResource Toggle}" x:Name="AnimationsBox" Content="Enable animations"/>

            <TextBlock Text="Audio visualizer" Style="{StaticResource FieldHeader}"/>
            <CheckBox Style="{StaticResource Toggle}" x:Name="VisualizerBox"
                      Content="React to Spotify audio (per-process loopback capture)"/>
            <TextBlock Style="{StaticResource FieldDesc}"
                       Text="Audio is analysed in memory only — never recorded. If per-process capture is unavailable the visualizer stays static and the reason is written to the log."/>

            <TextBlock Text="Lyrics" Style="{StaticResource FieldHeader}"/>
            <ComboBox x:Name="LyricsSourceCombo" Width="240" HorizontalAlignment="Left" FontSize="12">
                <ComboBoxItem Content="Automatic (local files, then LRCLIB)"/>
                <ComboBoxItem Content="LRCLIB only"/>
                <ComboBoxItem Content="Local files only"/>
                <ComboBoxItem Content="Off"/>
            </ComboBox>
            <TextBlock Text="Local lyrics folder (.lrc / .txt)" Style="{StaticResource FieldDesc}" Margin="0,8,0,3"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LyricsFolderBox" Grid.Column="0" FontSize="12" Height="26"
                         VerticalContentAlignment="Center" Background="#FF1E1E26"
                         Foreground="{StaticResource LabelBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Grid.Column="1" Content="Browse…" Width="80" Height="26" Margin="8,0,0,0"
                        Click="BrowseLyrics_Click"/>
            </Grid>

            <TextBlock Text="Position" Style="{StaticResource FieldHeader}"/>
            <ComboBox x:Name="AlignCombo" SelectedIndex="1" Width="160" HorizontalAlignment="Left" FontSize="12">
                <ComboBoxItem Content="Left"/>
                <ComboBoxItem Content="Center"/>
                <ComboBoxItem Content="Right"/>
            </ComboBox>
            <TextBlock Text="Vertical offset from top (pixels)" Style="{StaticResource FieldDesc}" Margin="0,8,0,2"/>
            <Slider x:Name="OffsetSlider" Minimum="0" Maximum="120" Value="0" Width="300" HorizontalAlignment="Left"/>
            <TextBlock x:Name="OffsetValue" Text="0 px" FontSize="11"
                       Foreground="{StaticResource SubBrush}" Margin="0,4,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
